{
  "radius": {
    "s": { "$value": "2px", "$type": "dimension" },
    "m": { "$value": "5px", "$type": "dimension" },
    "l": { "$value": "10px", "$type": "dimension" },
    "round": { "$value": "9999px", "$type": "dimension" }
  },
  "space": {
    "2": { "$value": "2px", "$type": "dimension" },
    "5": { "$value": "5px", "$type": "dimension" },
    "10": { "$value": "10px", "$type": "dimension" },
    "15": { "$value": "15px", "$type": "dimension" },
    "20": { "$value": "20px", "$type": "dimension" }
  },
  "font": {
    "$value": "\"Inter\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif",
    "$type": "fontFamily"
  }
}
